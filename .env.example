APP_ENV=local

DATABASE_URL=sqlite+aiosqlite:///./data/jobpilot.db

# Ollama на хосте. Из докера — http://host.docker.internal:11434
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b-instruct
OLLAMA_NUM_CTX=8192

BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:5173

BROWSER_USER_DATA_DIR=/data/browser/default

# для видимого Chromium из контейнера
DISPLAY=:0

# Ключи провайдеров здесь НЕ хранятся — они настраиваются в UI и лежат в БД
